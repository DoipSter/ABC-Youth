{
  "expo": {
    "name": "ABC-Youth",
    "slug": "ABC-Youth",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icons-no-border/icon-logo-no-border-home-180.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon-app-store-1024.png",
      "resizeMode": "cover",
      "backgroundColor": "#000"
    },
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.doip.ABCYouth",
      "buildNumber": "8",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "versionCode": 8,
      "newArchEnabled": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.doip.ABCYouth"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
          "expo-build-properties",
          {
              "ios": {
                  "useFrameworks": "static"
              }
          }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a9c6ec71-5f4b-4610-8134-9566b037a186"
      }
    },
    "owner": "doip"
  }
}
